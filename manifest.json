{
  "name": "הכספת שלי",
  "short_name": "הכספת",
  "description": "תלושי שכר, דרכונים ומסמכים משפחתיים, שמורים ב-Google Drive",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1f5",
  "theme_color": "#16233a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "file", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png"] } ] }
  }
}
